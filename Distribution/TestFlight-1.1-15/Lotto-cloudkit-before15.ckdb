DEFINE SCHEMA

    RECORD TYPE CD_InternationalLotteryEntry (
        CD_date                 TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_extraNumbers         BYTES QUERYABLE SORTABLE,
        CD_extraNumbers_ckAsset ASSET,
        CD_gameID               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_gameID_ckAsset       ASSET,
        CD_isDraw               INT64 QUERYABLE SORTABLE,
        CD_mainNumbers          BYTES QUERYABLE SORTABLE,
        CD_mainNumbers_ckAsset  ASSET,
        CD_moveReceipt          BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset  ASSET,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_JackPot (
        CD_dato                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_nr1                 INT64 QUERYABLE SORTABLE,
        CD_nr2                 INT64 QUERYABLE SORTABLE,
        CD_nr3                 INT64 QUERYABLE SORTABLE,
        CD_nr4                 INT64 QUERYABLE SORTABLE,
        CD_nr5                 INT64 QUERYABLE SORTABLE,
        CD_nr6                 INT64 QUERYABLE SORTABLE,
        CD_nr7                 INT64 QUERYABLE SORTABLE,
        CD_nr8                 INT64 QUERYABLE SORTABLE,
        CD_weekNr              INT64 QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_LotteryDeliveryChange (
        CD_changeID            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_changeID_ckAsset    ASSET,
        CD_changedAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_registered          INT64 QUERYABLE SORTABLE,
        CD_rowKey              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rowKey_ckAsset      ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_LotteryFavoriteChange (
        CD_changeID             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_changeID_ckAsset     ASSET,
        CD_changedAt            TIMESTAMP QUERYABLE SORTABLE,
        CD_enabled              INT64 QUERYABLE SORTABLE,
        CD_entityName           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_extraNumbers         BYTES QUERYABLE SORTABLE,
        CD_extraNumbers_ckAsset ASSET,
        CD_gameID               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_gameID_ckAsset       ASSET,
        CD_mainNumbers          BYTES QUERYABLE SORTABLE,
        CD_mainNumbers_ckAsset  ASSET,
        CD_moveReceipt          BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset  ASSET,
        "___createTime"         TIMESTAMP,
        "___createdBy"          REFERENCE,
        "___etag"               STRING,
        "___modTime"            TIMESTAMP,
        "___modifiedBy"         REFERENCE,
        "___recordID"           REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_LotteryLedgerEntry (
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entryID             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_entryID_ckAsset     ASSET,
        CD_gameID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_gameID_ckAsset      ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_note                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset        ASSET,
        CD_prizeOre            INT64 QUERYABLE SORTABLE,
        CD_stakeOre            INT64 QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Result (
        CD_dato                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_nr1                 INT64 QUERYABLE SORTABLE,
        CD_nr2                 INT64 QUERYABLE SORTABLE,
        CD_nr3                 INT64 QUERYABLE SORTABLE,
        CD_nr4                 INT64 QUERYABLE SORTABLE,
        CD_nr5                 INT64 QUERYABLE SORTABLE,
        CD_nr6                 INT64 QUERYABLE SORTABLE,
        CD_nr7                 INT64 QUERYABLE SORTABLE,
        CD_weekNr              INT64 QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
